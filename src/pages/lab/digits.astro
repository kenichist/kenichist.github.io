---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import DigitPad from '../../components/DigitPad.astro';
---

<Base title="Draw a digit" description="An in-browser handwritten digit classifier." noindex>
  <section class="wrap page" aria-labelledby="page-title">
    <BackLink href="/" label="home" />
    <h1 id="page-title" class="page-title">draw a digit</h1>
    <p class="intro muted">
      A small convolutional network trained on MNIST reads your drawing as you draw. Nothing leaves your browser.
    </p>
    <div class="lab">
      <DigitPad evaluate />
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .page-title {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    font-size: var(--step-3);
    letter-spacing: 0.02em;
  }

  .intro {
    max-width: var(--measure);
    margin-top: var(--space-4);
  }

  .lab {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
</style>
