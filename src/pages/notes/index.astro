---
import Base from '../../layouts/Base.astro';
import AsciiStrip from '../../components/AsciiStrip.astro';
import EntryList from '../../components/EntryList.astro';
import { content } from '../../lib/site-content';
import { formatDate } from '../../lib/content';

const items = content.notes.map((n) => ({ href: `/notes/${n.slug}/`, title: n.title, meta: formatDate(n.date) }));
---

<Base title="Notes" current="notes">
  <section class="wrap page" aria-labelledby="page-title">
    <AsciiStrip seed={53} rows={5} />
    <h1 id="page-title" class="page-title enter">notes</h1>
    <p class="intro muted enter" style="--i: 1">Research notes and working write-ups.</p>
    <div class="list">
      {items.length > 0 ? <EntryList items={items} size="small" label="All notes" /> : <p class="empty">No notes published yet.</p>}
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
    max-width: calc(56rem + 2 * var(--gutter));
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    /* keep the left edge aligned with the header on wide screens */
    .page {
      max-width: calc(var(--max-width) + 2 * var(--gutter));
    }

    .page > :global(*) {
      max-width: 56rem;
    }
  }

  .page :global(.ascii-strip) {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .page-title {
    font-size: var(--step-3);
    letter-spacing: 0.02em;
  }

  .intro {
    margin-top: var(--space-4);
  }

  .list {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
</style>
