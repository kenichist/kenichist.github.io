---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { content } from '../lib/site-content';
import { site } from '../content/site';

interface Props {
  /** Page name; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  current?: 'work' | 'notes';
  /** Force noindex (e.g. 404). Demo mode always sets it. */
  noindex?: boolean;
}

const { title, description = site.description, current, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.titleSuffix}` : `${site.titleSuffix} — ${content.profile.role}`;
const robots = content.demo || noindex ? 'noindex, nofollow' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#16121e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/iosevka-subset-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Entry loader: show on arrival from outside the site or on reload, not on internal navigation.
      (function () {
        var d = document.documentElement;
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var internal = false;
          try {
            internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
          } catch (e) {}
          if ((nav && nav.type === 'reload') || !internal) {
            d.classList.add('is-loading');
            d.setAttribute('aria-busy', 'true');
          }
        } catch (e) {}
        // A cross-document view transition can be skipped (e.g. on a fast back/forward);
        // Chrome then rejects its promises. Nothing depends on them, so swallow that.
        function quiet(e) {
          var vt = e.viewTransition;
          if (!vt) return;
          [vt.ready, vt.finished, vt.updateCallbackDone].forEach(function (p) {
            if (p && p.catch) p.catch(function () {});
          });
        }
        addEventListener('pagereveal', quiet); // incoming page
        addEventListener('pageswap', quiet); // outgoing page
        // Some skipped transitions reject promises we never see; drop only that specific error.
        addEventListener('unhandledrejection', function (e) {
          var r = e.reason;
          if (r && r.name === 'InvalidStateError' && /Transition was (aborted|skipped)/.test(r.message)) e.preventDefault();
        });
      })();
    </script>
  </head>
  <body data-follower={site.hero === 'koi' ? 'koi' : undefined}>
    <Loader />
    <a class="skip-link" href="#main">skip to content</a>
    <Header current={current} demo={content.demo} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { enhanceReveals } from '../scripts/reveal';
      import { startFollower } from '../scripts/koi/follower';
      enhanceReveals();
      startFollower();
    </script>
  </body>
</html>
