---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { content } from '../lib/site-content';
import { site } from '../content/site';

interface Props {
  /** Page name; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  current?: 'work' | 'notes';
  /** Force noindex (e.g. 404). Demo mode always sets it. */
  noindex?: boolean;
}

const { title, description = site.description, current, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.titleSuffix}` : `${site.titleSuffix} — ${content.profile.role}`;
const robots = content.demo || noindex ? 'noindex, nofollow' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#16121e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/iosevka-subset-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Before first paint: entry loader (arrival from outside the site, or reload), or the
      // second half of an ASCII page transition (a click on a link to another page of this site).
      (function () {
        var d = document.documentElement;
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var type = nav ? nav.type : 'navigate';
          var internal = false;
          try {
            internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
          } catch (e) {}
          if (type === 'reload' || !internal) {
            d.classList.add('is-loading');
            d.setAttribute('aria-busy', 'true');
          }
          var raw = sessionStorage.getItem('ks-nav');
          if (raw) {
            var t = JSON.parse(raw);
            var fresh = Date.now() - t.ts < 4000 && type === 'navigate' && t.to === location.pathname;
            if (fresh && !d.classList.contains('is-loading') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
              d.classList.add('is-arriving');
            } else {
              sessionStorage.removeItem('ks-nav');
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Loader />
    <a class="skip-link" href="#main">skip to content</a>
    <Header current={current} demo={content.demo} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { enhanceReveals } from '../scripts/reveal';
      import { enhanceTransitions } from '../scripts/transition';
      enhanceTransitions();
      enhanceReveals();
    </script>
  </body>
</html>
