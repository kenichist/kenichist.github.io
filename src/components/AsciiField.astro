---
import { existsSync, readFileSync } from 'node:fs';
import { DEFAULT_SEED, renderTextFrame } from '../scripts/ascii/field';
import { clipFrameText, isFieldClip, type FieldClip } from '../scripts/ascii/frames';
import { KOI_GLYPHS } from '../scripts/koi/fish';
import { Pond, pondText } from '../scripts/koi/pond';
import { site } from '../content/site';

/**
 * Hero character field. Server-renders a seeded still frame as text (shown
 * without JS, and until the canvas is ready), then the canvas takes over with
 * the same grid, so the hand-off doesn't jump.
 *
 * Grid sizes must match --field-cols / --field-rows in the CSS below.
 */
interface Props {
  seed?: number;
  /** 'koi' → koi pond; 'field' → wind field (or a configured video clip) */
  scene?: 'koi' | 'field';
}
const { seed = DEFAULT_SEED, scene = 'field' } = Astro.props;
const koi = scene === 'koi';

/** Cell grid per breakpoint; must match --field-cols / --field-rows below. */
const GRID = koi ? { wide: [96, 30], narrow: [52, 24] } : { wide: [70, 21], narrow: [46, 18] };
/** Pond text frame at a nominal width; the client rebuilds the same pond at its real size. */
const pondFrame = (cols: number, rows: number, w: number) => pondText(new Pond(w, (w * rows * 1.28) / (cols * 0.78)), cols, rows, KOI_GLYPHS);

/** A configured video clip replaces the procedural field; a missing or invalid file falls back to it. */
function loadClip(variant: 'wide' | 'narrow'): FieldClip | null {
  if (koi || !site.fieldClip) return null;
  const file = `public/field/${site.fieldClip}.${variant}.json`;
  if (!existsSync(file)) {
    console.warn(`[field] ${file} not found — using the procedural field`);
    return null;
  }
  const data = JSON.parse(readFileSync(file, 'utf8'));
  return isFieldClip(data) ? data : null;
}
const clipWide = loadClip('wide');
const clipNarrow = loadClip('narrow');
const useClip = !!(clipWide && clipNarrow);
const [wc, wr] = GRID.wide;
const [nc, nr] = GRID.narrow;
const wide = koi ? pondFrame(wc, wr, 714) : useClip ? clipFrameText(clipWide!, clipWide!.poster, wc, wr) : renderTextFrame(wc, wr, seed);
const narrow = koi ? pondFrame(nc, nr, 350) : useClip ? clipFrameText(clipNarrow!, clipNarrow!.poster, nc, nr) : renderTextFrame(nc, nr, seed);
const clipAttrs = useClip
  ? { 'data-clip-wide': `/field/${site.fieldClip}.wide.json`, 'data-clip-narrow': `/field/${site.fieldClip}.narrow.json` }
  : {};
---

<div class="field" data-ascii-field data-scene={scene} data-seed={seed} data-state="static" {...clipAttrs}>
  <div class="field-surface" data-field-surface aria-hidden="true">
    <pre class="field-text field-text-wide">{wide}</pre>
    <pre class="field-text field-text-narrow">{narrow}</pre>
  </div>
  <div class="field-controls">
    <p class="field-hint" data-field-hint aria-hidden="true"></p>
    <button type="button" class="field-toggle" data-field-toggle hidden>
      <span aria-hidden="true">[</span>
      <span data-label>pause</span><span class="sr-only" data-sr> the background animation</span>
      <span aria-hidden="true">]</span>
    </button>
  </div>
</div>

<script>
  import { enhanceFields } from '../scripts/ascii/controller';
  enhanceFields();
</script>

<style>
  .field {
    --field-cols: 70;
    --field-rows: 21;
    /* 0.78em cell width × 70 cols; 1.28em row height × 21 rows */
    min-width: 0;
  }

  .field-surface {
    position: relative;
    container-type: inline-size;
    /* height is derived from width so the grid never reflows: rows × 1.28em,
       where 1em = width / (cols × 0.78) */
    aspect-ratio: calc(var(--field-cols) * 0.78) / calc(var(--field-rows) * 1.28);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .field-text {
    position: absolute;
    inset: 0;
    margin: 0;
    font-family: inherit;
    font-size: calc(100cqi / (var(--field-cols) * 0.78));
    line-height: 1.28;
    letter-spacing: 0.28em;
    white-space: pre;
    color: var(--color-accent);
    transition: opacity 360ms ease-out;
  }

  .field-text-narrow {
    display: none;
  }

  .field[data-scene='koi'] {
    --field-cols: 96;
    --field-rows: 30;
  }

  /* canvas is inserted by the controller */
  .field-surface :global(.field-canvas) {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    opacity: 0;
    transition: opacity 360ms ease-out;
  }

  .field:global(.is-live) .field-text {
    opacity: 0;
  }

  .field:global(.is-live) .field-surface :global(.field-canvas) {
    opacity: 1;
  }

  .field-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    margin-top: var(--space-3);
    padding-inline: 7% 3%;
    font-size: var(--step--1);
    letter-spacing: var(--track-nav);
  }

  .field-hint {
    color: var(--color-text-2);
  }

  .field-toggle {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-1);
    margin-inline-start: auto;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-accent-text);
    transition: color var(--dur-micro) ease-out;
  }

  .field-toggle[hidden] {
    display: none;
  }

  .field-toggle:hover,
  .field-toggle:focus-visible {
    color: var(--color-text);
  }

  @media (max-width: 39.99rem) {
    .field {
      --field-cols: 46;
      --field-rows: 18;
    }

    .field[data-scene='koi'] {
      --field-cols: 52;
      --field-rows: 24;
    }

    .field-text-wide {
      display: none;
    }

    .field-text-narrow {
      display: block;
    }

    .field-controls {
      padding-inline: 0;
    }
  }
</style>
