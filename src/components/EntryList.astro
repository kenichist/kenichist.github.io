---
/** Sparse title + arrow rows. Used for work and notes, on the homepage and indexes. */
interface Item {
  href: string;
  title: string;
  meta?: string;
}
interface Props {
  items: Item[];
  size?: 'large' | 'small';
  /** Accessible list name. */
  label: string;
}
const { items, size = 'large', label } = Astro.props;
---

<ol class:list={['rows', `rows-${size}`]} aria-label={label}>
  {
    items.map((item) => (
      <li>
        <a class="row" href={item.href}>
          <span class="row-text">
            <span class="row-title">{item.title}</span>
            {item.meta && <span class="row-meta">{item.meta}</span>}
          </span>
          <span class="row-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .rows-large {
    font-size: var(--step-2);
    letter-spacing: 0.05em;
    line-height: 1.3;
  }

  .rows-small {
    --row-pad: clamp(1rem, 0.85rem + 0.5vw, 1.375rem);
    font-size: var(--step-1);
    letter-spacing: var(--track-nav);
    line-height: 1.4;
  }
</style>
